# manifest/README. Everything below is development-only and never packaged.
src/**
test/**
node_modules/**
.vscode/**
dist-test/**
.vscode-test/**
esbuild.mjs
esbuild.test.mjs
tsconfig.json
**/*.map
**/*.ts
.gitignore
